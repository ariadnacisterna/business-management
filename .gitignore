# Secretos y configuración privada — nunca se versionan
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Datos reales del negocio (muestras, precios, catálogos) — nunca se versionan
# tal cual; si hace falta compartirlos con una conversación de tarea, guardarlos
# acá y anonimizar antes de commitear cualquier ejemplo.
/datos-reales/
*.xlsx
*.xls
!docs/**/*.xlsx

# Bases de datos locales y copias de seguridad
*.sqlite3
*.dump
*.backup

# Python (backend)
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node / TypeScript (frontend SPA)
node_modules/
dist/
build/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
